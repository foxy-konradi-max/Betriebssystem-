QWidget { font-family: "Inter", sans-serif; font-size: 13px; }
#mainApp { background: #f7f5f7; }
QPushButton { background: #e95420; color: white; border: none; border-radius: 8px; padding: 7px 18px; font-weight: 600; }
QPushButton:hover { background: #f06a3b; }
QPushButton:disabled { background: #d6d0d9; color: #8a808f; }
QLineEdit, QComboBox { border: 1px solid #d6d0d9; border-radius: 8px; padding: 6px 8px; background: white; }
QProgressBar { border: 0; border-radius: 4px; background: #e3dde6; max-height: 8px; text-align: center; }
QProgressBar::chunk { background: #e95420; border-radius: 4px; }
